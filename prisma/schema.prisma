// ─── LOCAL DEV (SQLite) ───────────────────────────────────────────────────────
// For production (PostgreSQL) see schema.prod.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NEXT-AUTH
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// IDENTITY
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique  // null for contacts who haven't signed up
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Contact fields — isContact=true means added by another user, no own account
  isContact      Boolean @default(false)
  contactOwnerId String?                           // the User who added this contact
  contactOwner   User?   @relation("UserContacts", fields: [contactOwnerId], references: [id])
  contacts       User[]  @relation("UserContacts") // contacts this user has added

  // NextAuth
  accounts Account[]
  sessions Session[]

  // App
  groupMemberships   GroupMember[]
  eventParticipants  EventParticipant[]
  payments           Payment[]
  itemFractions      ItemFraction[]
  directExpenses     DirectExpense[]
  directExpSplits    DirectExpenseSplit[]
  createdEvents      Event[]

  @@index([email])
  @@index([contactOwnerId])
}

// ---------------------------------------------------------------------------
// GROUPS
// ---------------------------------------------------------------------------

model Group {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("👥")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        GroupMember[]
  directExpenses DirectExpense[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// EVENTS  (standalone — no longer require a group)
// ---------------------------------------------------------------------------

model Event {
  id          String    @id @default(cuid())
  createdById String
  groupId     String?   // optional — events can be standalone
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy      User              @relation(fields: [createdById], references: [id])
  participants   EventParticipant[]
  establishments Establishment[]

  @@index([createdById])
  @@index([groupId])
}

model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// BILL HIERARCHY  Event → Establishment → Bill → LineItem → ItemFraction
//                                              ↘ Payment
// ---------------------------------------------------------------------------

model Establishment {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  address   String?
  category  String?
  createdAt DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bills Bill[]

  @@index([eventId])
}

model Bill {
  id                String   @id @default(cuid())
  establishmentId   String
  subtotalCents     Int
  taxCents          Int      @default(0)
  tipCents          Int      @default(0)   // service tax
  gratuityCents     Int      @default(0)   // tip / gratuity
  totalCents        Int
  currency          String   @default("USD")
  receiptUrl        String?
  receiptStorageKey String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  lineItems     LineItem[]
  payments      Payment[]

  @@index([establishmentId])
}

model LineItem {
  id         String @id @default(cuid())
  billId     String
  name       String
  quantity   Int    @default(1)
  unitCents  Int
  totalCents Int

  bill      Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  fractions ItemFraction[]

  @@index([billId])
}

model ItemFraction {
  id          String @id @default(cuid())
  lineItemId  String
  userId      String
  numerator   Int
  denominator Int

  lineItem LineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lineItemId, userId])
  @@index([lineItemId])
  @@index([userId])
}

model Payment {
  id          String  @id @default(cuid())
  billId      String
  userId      String
  amountCents Int
  method      String?
  note        String?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// DIRECT EXPENSE  (can belong to group, event, or neither)
// ---------------------------------------------------------------------------

model DirectExpense {
  id          String   @id @default(cuid())
  paidById    String
  groupId     String?  // optional
  eventId     String?  // optional
  description String
  totalCents  Int
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  paidBy Group?               @relation(fields: [groupId], references: [id])
  // NOTE: paidBy user tracked via splits (payer has numerator covering their payment)
  paidByUser User             @relation(fields: [paidById], references: [id])
  splits     DirectExpenseSplit[]

  @@index([groupId])
  @@index([eventId])
  @@index([paidById])
}

model DirectExpenseSplit {
  id              String @id @default(cuid())
  directExpenseId String
  userId          String
  numerator       Int
  denominator     Int

  directExpense DirectExpense @relation(fields: [directExpenseId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([directExpenseId, userId])
  @@index([directExpenseId])
  @@index([userId])
}
