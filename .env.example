# ─── Database ────────────────────────────────────────────────────────────────
# Neon / Supabase pooler URL (used at runtime by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/splitkaro?pgbouncer=true&connection_limit=1"
# Direct connection (used only by prisma migrate / prisma studio)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/splitkaro"

# ─── Auth (NextAuth) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# In development this is http://localhost:3000; in production your Vercel URL
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Anthropic (OCR) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Vercel Blob (receipt storage) ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
